{
  "name": "ckb-vscode",
  "displayName": "CKB - Invisible Reality Architecture Intelligence",
  "description": "See what code hides: semantic architecture, molecular data-flow paths, runtime evidence, fault pressure, ripple analysis and model-ready software memory inside VS Code.",
  "version": "1.4.0",
  "publisher": "TechCodinz",
  "icon": "icon.png",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/TechCodinz/CKB" },
  "keywords": ["architecture","dependency","analysis","mcp","ai","code-quality","architecture-memory","runtime-intelligence","blast-radius","code-graph","data-flow","observability","software-visualization","code-intelligence"],
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Linters","Other","Programming Languages","Visualization"],
  "activationEvents": ["onStartupFinished","onView:ckb.realityView"],
  "main": "./out/extensionV6.js",
  "contributes": {
    "viewsContainers": { "activitybar": [{ "id": "ckb-reality", "title": "CKB Invisible Reality", "icon": "icon.png" }] },
    "views": { "ckb-reality": [{ "type": "webview", "id": "ckb.realityView", "name": "Invisible Reality V5", "contextualTitle": "CKB Molecular Software Microscope" }] },
    "commands": [
      { "command": "ckb.openReality", "title": "CKB: Open Invisible Reality", "icon": "$(telescope)" },
      { "command": "ckb.revealArchitecture", "title": "CKB: Reveal My Architecture", "icon": "$(sparkle)" },
      { "command": "ckb.shareRealitySnapshot", "title": "CKB: Share Reality Snapshot", "icon": "$(share)" },
      { "command": "ckb.openCloudContinuity", "title": "CKB: Continue in Cloud Living Universe", "icon": "$(globe)" },
      { "command": "ckb.explainCloudValue", "title": "CKB: Explore Cloud Reality Capabilities", "icon": "$(layers)" },
      { "command": "ckb.deepActivity", "title": "CKB: Deep Activity Analysis", "icon": "$(pulse)" },
      { "command": "ckb.queryMemory", "title": "CKB: Query Architecture Memory", "icon": "$(database)" },
      { "command": "ckb.scan", "title": "CKB: Scan Project", "icon": "$(search)" },
      { "command": "ckb.check", "title": "CKB: Check Architecture", "icon": "$(shield)" },
      { "command": "ckb.impact", "title": "CKB: Analyze Change Ripple at Cursor", "icon": "$(git-compare)" },
      { "command": "ckb.openExplorer", "title": "CKB: Open Cloud Living Universe", "icon": "$(globe)" },
      { "command": "ckb.showStatus", "title": "CKB: Architecture Actions", "icon": "$(info)" },
      { "command": "ckb.startServer", "title": "CKB: Start MCP Server", "icon": "$(server)" },
      { "command": "ckb.setApiKey", "title": "CKB: Set API Key", "icon": "$(key)" }
    ],
    "keybindings": [
      { "command": "ckb.impact", "key": "shift+ctrl+i", "mac": "shift+cmd+i", "when": "editorTextFocus" },
      { "command": "ckb.queryMemory", "key": "shift+ctrl+m", "mac": "shift+cmd+m" }
    ],
    "configuration": {
      "title": "CKB Invisible Reality Architecture Intelligence",
      "properties": {
        "ckb.serverUrl": { "type": "string", "default": "http://localhost:3000", "description": "CKB server used only as a fallback or explicit Reality/MCP connection. A remote server cannot read local filesystem paths unless the project is uploaded/scanned through a supported remote source flow." },
        "ckb.apiKey": { "type": "string", "default": "", "markdownDescription": "API key sent as `X-API-Key` only to the configured `ckb.serverUrl`.", "editPresentation": "singlelineText" },
        "ckb.cloudApiUrl": { "type": "string", "default": "https://ckb-backend-api.onrender.com", "description": "Authenticated CKB Cloud API used by the programmatic patch-transaction agent. Local source paths and source contents are never uploaded by this client." },
        "ckb.cliBinary": { "type": "string", "default": "ckb", "description": "Executable name/path for the standard CKB CLI." },
        "ckb.intelligenceBinary": { "type": "string", "default": "ckb-intelligence", "description": "Executable name/path for the high-performance CKB IDE intelligence facade." },
        "ckb.analysisTimeoutMs": { "type": "number", "default": 120000, "minimum": 30000, "maximum": 600000, "description": "Maximum duration of a local deep architecture analysis or CKB server request." },
        "ckb.autoScanOnOpen": { "type": "boolean", "default": true, "description": "Hydrate Invisible Reality shortly after a workspace opens." },
        "ckb.rescanOnSave": { "type": "boolean", "default": true, "description": "Coalesce source-file changes and refresh architecture intelligence after editing activity settles." },
        "ckb.rescanDebounceMs": { "type": "number", "default": 1400, "minimum": 350, "maximum": 30000, "description": "Quiet period used to coalesce rapid file changes into one analysis pass." },
        "ckb.deepAnalysisOnSave": { "type": "boolean", "default": true, "description": "Refresh deep activity + architecture memory after the debounced save/change window." },
        "ckb.showDiagnostics": { "type": "boolean", "default": true, "description": "Show evidence-backed architecture findings as inline diagnostics." },
        "ckb.productGuidance": { "type": "boolean", "default": true, "description": "Show first-run reveal guidance and one-time evidence-backed milestones. Disable for a completely silent product experience." },
        "ckb.cloudExplorerUrl": { "type": "string", "default": "https://ckb-nu.vercel.app/project/current", "description": "Cloud Project Explorer opened from the Invisible Reality cockpit." }
      }
    },
    "menus": {
      "editor/context": [
        { "when": "editorTextFocus", "command": "ckb.impact", "group": "ckb@1" },
        { "when": "editorTextFocus", "command": "ckb.queryMemory", "group": "ckb@2" }
      ],
      "view/title": [
        { "command": "ckb.revealArchitecture", "when": "view == ckb.realityView", "group": "navigation@1" },
        { "command": "ckb.shareRealitySnapshot", "when": "view == ckb.realityView", "group": "navigation@2" },
        { "command": "ckb.openCloudContinuity", "when": "view == ckb.realityView", "group": "navigation@3" }
      ],
      "commandPalette": [
        { "command": "ckb.revealArchitecture" },
        { "command": "ckb.shareRealitySnapshot" },
        { "command": "ckb.openCloudContinuity" }
      ]
    }
  },
  "scripts": { "compile": "tsc -p ./", "watch": "tsc -watch -p ./", "package": "vsce package", "publish": "vsce publish" },
  "devDependencies": { "@types/vscode": "^1.85.0", "@types/node": "^20.0.0", "typescript": "^5.3.0", "@vscode/vsce": "^2.22.0" }
}
