{
    "name": "ckb-vscode",
    "displayName": "CKB - Living Architecture Intelligence",
    "description": "See software architecture as a living system: deep activity, change ripple, runtime evidence and model-ready architecture memory.",
    "version": "1.2.0",
    "publisher": "TechCodinz",
    "icon": "icon.png",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/TechCodinz/CKB"
    },
    "keywords": [
        "architecture",
        "dependency",
        "analysis",
        "mcp",
        "ai",
        "code-quality",
        "architecture-memory",
        "runtime-intelligence",
        "blast-radius",
        "code-graph"
    ],
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Linters",
        "Other",
        "Programming Languages",
        "Visualization"
    ],
    "activationEvents": [
        "onStartupFinished",
        "onView:ckb.realityView"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "ckb-reality",
                    "title": "CKB Reality",
                    "icon": "icon.png"
                }
            ]
        },
        "views": {
            "ckb-reality": [
                {
                    "type": "webview",
                    "id": "ckb.realityView",
                    "name": "Living Architecture Reality",
                    "contextualTitle": "CKB Living Reality"
                }
            ]
        },
        "commands": [
            {
                "command": "ckb.openReality",
                "title": "CKB: Open Living Architecture Reality",
                "icon": "$(rocket)"
            },
            {
                "command": "ckb.deepActivity",
                "title": "CKB: Deep Activity Analysis",
                "icon": "$(pulse)"
            },
            {
                "command": "ckb.queryMemory",
                "title": "CKB: Query Architecture Memory",
                "icon": "$(database)"
            },
            {
                "command": "ckb.scan",
                "title": "CKB: Scan Project",
                "icon": "$(search)"
            },
            {
                "command": "ckb.check",
                "title": "CKB: Check Architecture",
                "icon": "$(shield)"
            },
            {
                "command": "ckb.impact",
                "title": "CKB: Analyze Change Ripple at Cursor",
                "icon": "$(git-compare)"
            },
            {
                "command": "ckb.openExplorer",
                "title": "CKB: Open Cloud Project Explorer",
                "icon": "$(globe)"
            },
            {
                "command": "ckb.showStatus",
                "title": "CKB: Architecture Actions",
                "icon": "$(info)"
            },
            {
                "command": "ckb.startServer",
                "title": "CKB: Start MCP Server",
                "icon": "$(server)"
            },
            {
                "command": "ckb.setApiKey",
                "title": "CKB: Set API Key",
                "icon": "$(key)"
            }
        ],
        "keybindings": [
            {
                "command": "ckb.impact",
                "key": "shift+ctrl+i",
                "mac": "shift+cmd+i",
                "when": "editorTextFocus"
            },
            {
                "command": "ckb.queryMemory",
                "key": "shift+ctrl+m",
                "mac": "shift+cmd+m"
            }
        ],
        "configuration": {
            "title": "CKB Living Architecture Intelligence",
            "properties": {
                "ckb.serverUrl": {
                    "type": "string",
                    "default": "http://localhost:3000",
                    "description": "CKB server used only as a fallback or explicit Reality/MCP connection. A remote server cannot read local filesystem paths unless the project is uploaded/scanned through a supported remote source flow."
                },
                "ckb.apiKey": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "API key sent as `X-API-Key` only to the configured `ckb.serverUrl`.",
                    "editPresentation": "singlelineText"
                },
                "ckb.cliBinary": {
                    "type": "string",
                    "default": "ckb",
                    "description": "Executable name/path for the standard CKB CLI."
                },
                "ckb.intelligenceBinary": {
                    "type": "string",
                    "default": "ckb-intelligence",
                    "description": "Executable name/path for the high-performance CKB IDE intelligence facade (deep activity, Code DNA and bounded architecture memory)."
                },
                "ckb.analysisTimeoutMs": {
                    "type": "number",
                    "default": 120000,
                    "minimum": 30000,
                    "maximum": 600000,
                    "description": "Maximum duration of a local deep architecture analysis or CKB server request."
                },
                "ckb.autoScanOnOpen": {
                    "type": "boolean",
                    "default": true,
                    "description": "Hydrate Living Architecture Reality shortly after a workspace opens."
                },
                "ckb.rescanOnSave": {
                    "type": "boolean",
                    "default": true,
                    "description": "Coalesce source-file changes and refresh architecture intelligence after editing activity settles."
                },
                "ckb.rescanDebounceMs": {
                    "type": "number",
                    "default": 1400,
                    "minimum": 350,
                    "maximum": 30000,
                    "description": "Quiet period used to coalesce rapid file changes into one analysis pass."
                },
                "ckb.deepAnalysisOnSave": {
                    "type": "boolean",
                    "default": true,
                    "description": "Refresh deep activity + architecture memory after the debounced save/change window. Disable for extremely large repos if you prefer manual deep analysis."
                },
                "ckb.showDiagnostics": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show evidence-backed architecture findings as inline diagnostics."
                },
                "ckb.cloudExplorerUrl": {
                    "type": "string",
                    "default": "https://ckb-nu.vercel.app/project/current",
                    "description": "Cloud Project Explorer opened from the Living Reality cockpit."
                }
            }
        },
        "menus": {
            "editor/context": [
                {
                    "when": "editorTextFocus",
                    "command": "ckb.impact",
                    "group": "ckb@1"
                },
                {
                    "when": "editorTextFocus",
                    "command": "ckb.queryMemory",
                    "group": "ckb@2"
                }
            ],
            "view/title": [
                {
                    "command": "ckb.deepActivity",
                    "when": "view == ckb.realityView",
                    "group": "navigation@1"
                },
                {
                    "command": "ckb.queryMemory",
                    "when": "view == ckb.realityView",
                    "group": "navigation@2"
                }
            ]
        }
    },
    "scripts": {
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "package": "vsce package",
        "publish": "vsce publish"
    },
    "devDependencies": {
        "@types/vscode": "^1.85.0",
        "@types/node": "^20.0.0",
        "typescript": "^5.3.0",
        "@vscode/vsce": "^2.22.0"
    }
}
