<idea-plugin>
    <id>dev.ckb.jetbrains</id>
    <name>CKB - Living Architecture Intelligence</name>
    <vendor email="support@ckb.dev" url="https://ckb.dev">CKB</vendor>
    <version>1.3.0</version>
    <idea-version since-build="233" until-build="243.*"/>

    <description><![CDATA[
        <b>CKB – Living Architecture Intelligence</b><br><br>
        Explore software as an evidence-backed internal system instead of a flat collection of files.<br><br>
        <ul>
            <li>🌌 Living Architecture Reality cockpit inside the IDE</li>
            <li>🔬 Invisible Reality V5 molecular software microscope</li>
            <li>⚡ Deep activity hotspots, change sensitivity and architecture boundaries</li>
            <li>🧠 Bounded architecture memory for AI/model context without dumping the whole repository</li>
            <li>🛡️ Evidence-backed architecture findings and dependency drift</li>
            <li>🔮 Change ripple analysis before code is modified</li>
            <li>🟢 Runtime evidence stays separate from static structure and predicted impact</li>
            <li>🤖 MCP/agent integration for model-neutral architecture intelligence</li>
        </ul>
        Supports IntelliJ IDEA, PyCharm, WebStorm, GoLand, Rider and Android Studio families where platform compatibility permits.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="CKB"
                    displayName="CKB Living Reality"
                    anchor="bottom"
                    icon="/icons/ckb_tool_window.svg"
                    factoryClass="dev.ckb.toolwindow.CkbToolWindowFactory"/>
        <toolWindow id="CKB Microscope"
                    displayName="CKB Invisible Reality V5"
                    anchor="right"
                    secondary="true"
                    icon="/icons/ckb_tool_window.svg"
                    factoryClass="dev.ckb.toolwindow.CkbMolecularToolWindowFactory"/>

        <applicationConfigurable
                parentId="tools"
                instance="dev.ckb.settings.CkbSettingsConfigurable"
                id="dev.ckb.settings"
                displayName="CKB Living Architecture"/>
        <applicationService
                serviceImplementation="dev.ckb.settings.CkbSettings"/>
    </extensions>

    <actions>
        <group id="CkbMenuGroup" text="CKB Living Architecture" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>

            <action id="CkbScanAction"
                    class="dev.ckb.actions.ScanProjectAction"
                    text="Scan Project"
                    description="Refresh the evidence-backed CKB architecture scan"
                    icon="AllIcons.Actions.Find"/>
            <action id="CkbCheckAction"
                    class="dev.ckb.actions.CheckArchitectureAction"
                    text="Check Architecture"
                    description="Check current architecture findings"
                    icon="AllIcons.General.InspectionsOK"/>
            <action id="CkbImpactAction"
                    class="dev.ckb.actions.AnalyzeImpactAction"
                    text="Analyze Change Ripple at Cursor"
                    description="Predict direct and transitive architectural impact at the current cursor"
                    icon="AllIcons.Debugger.Watch">
                <keyboard-shortcut keymap="$default" first-keystroke="shift ctrl I"/>
            </action>
            <action id="CkbGraphAction"
                    class="dev.ckb.actions.ShowGraphAction"
                    text="Open Architecture Graph"
                    description="Open CKB architecture graph visualization"
                    icon="AllIcons.Toolwindows.Dependencies"/>
        </group>

        <group id="CkbEditorGroup">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <action id="CkbImpactContextAction"
                    class="dev.ckb.actions.AnalyzeImpactAction"
                    text="CKB: Analyze Change Ripple Here"
                    description="Predict architectural impact at this source location"
                    icon="AllIcons.Debugger.Watch"/>
        </group>
    </actions>
</idea-plugin>
