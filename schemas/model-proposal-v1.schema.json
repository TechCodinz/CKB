{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ckb.dev/schemas/model-proposal-v1.schema.json",
  "title": "CKB Model Proposal V1",
  "description": "Provider-neutral reasoning/proposal response. A proposal is never an applied change and must reference the CKB evidence it relied on.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "requestId", "anchor", "summary", "evidenceReferences", "assumptions", "requestedActions", "mutationApplied", "synthetic"],
  "properties": {
    "version": { "const": "ckb-model-proposal-v1" },
    "requestId": { "type": "string", "minLength": 1, "maxLength": 240 },
    "anchor": { "$ref": "./ckb-memory-anchor-v1.schema.json" },
    "summary": { "type": "string", "minLength": 1, "maxLength": 12000 },
    "evidenceReferences": {
      "type": "array",
      "maxItems": 500,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    },
    "assumptions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["statement", "status"],
        "properties": {
          "statement": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "status": { "enum": ["unverified", "validated", "rejected"] },
          "evidenceReferences": {
            "type": "array",
            "maxItems": 50,
            "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
          }
        }
      }
    },
    "requestedActions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "description"],
        "properties": {
          "kind": { "enum": ["query-more", "simulate", "prepare-change", "validate", "human-decision", "none"] },
          "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "aql": { "type": ["string", "null"], "maxLength": 12000 }
        }
      }
    },
    "proposedPatch": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "format": { "enum": ["unified-diff"] },
        "content": { "type": "string", "maxLength": 4194304 },
        "baselineSnapshotId": { "type": "string", "minLength": 1, "maxLength": 500 }
      },
      "required": ["format", "content", "baselineSnapshotId"]
    },
    "mutationApplied": { "const": false },
    "synthetic": { "const": false }
  }
}
