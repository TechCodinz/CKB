{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ckb.dev/schemas/frontier-model-release-observation-v1.schema.json",
  "title": "CKB Frontier Model Release Observation V1",
  "description": "Primary-source observation envelope used to update model capability data without changing CKB architecture truth or hardcoding provider-specific logic.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "provider", "model", "observedAt", "primarySources", "capabilities", "synthetic"],
  "properties": {
    "version": { "const": "ckb-frontier-model-release-observation-v1" },
    "provider": { "type": "string", "minLength": 1, "maxLength": 160 },
    "model": { "type": "string", "minLength": 1, "maxLength": 200 },
    "releasedAt": { "type": ["string", "null"], "format": "date-time" },
    "observedAt": { "type": "string", "format": "date-time" },
    "primarySources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "reference"],
        "properties": {
          "kind": { "enum": ["official-doc", "official-release", "provider-api"] },
          "reference": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "contentFingerprint": { "type": ["string", "null"], "maxLength": 256 }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supportsStructuredOutput", "supportsToolUse", "supportsParallelTools", "supportsImages", "supportsCodeExecution"],
      "properties": {
        "contextWindowTokens": { "type": ["integer", "null"], "minimum": 1, "maximum": 20000000 },
        "maxOutputTokens": { "type": ["integer", "null"], "minimum": 1, "maximum": 2000000 },
        "supportsStructuredOutput": { "type": "boolean" },
        "supportsToolUse": { "type": "boolean" },
        "supportsParallelTools": { "type": "boolean" },
        "supportsImages": { "type": "boolean" },
        "supportsCodeExecution": { "type": "boolean" },
        "supportsLongRunningAgents": { "type": "boolean", "default": false }
      }
    },
    "deprecates": {
      "type": "array",
      "maxItems": 50,
      "items": { "type": "string", "maxLength": 200 }
    },
    "notes": { "type": ["string", "null"], "maxLength": 4000 },
    "synthetic": { "const": false }
  }
}
