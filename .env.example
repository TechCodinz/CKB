# CKB Environment Variables
# Copy this file to .env and fill in your values

# ─── Database (Supabase) ───
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# ─── Auth (REQUIRED — backend refuses to start in production without this) ───
# Generate with: openssl rand -base64 48
JWT_SECRET=

# ─── Payments (Coinbase Commerce) ───
COINBASE_COMMERCE_API_KEY=your_coinbase_api_key
COINBASE_COMMERCE_WEBHOOK_SECRET=your_webhook_shared_secret

# ─── Internal service-to-service auth ───
INTERNAL_API_SECRET=
BACKEND_URL=https://your-ckb-api.onrender.com

# ─── Frontend (React Dashboard) ───
REACT_APP_API_URL=https://your-ckb-api.onrender.com

# ─── MCP Server ───
CKB_API_KEY=
CKB_BACKEND_URL=
CKB_INTERNAL_SECRET=
CKB_ALLOWED_ORIGIN=
CKB_BIND_ALL=
ANTHROPIC_API_KEY=
# CKB_EXPLAIN_MODEL=claude-haiku-4-5-20251001

# ─── EchoForge Sentinel Intelligence Bridge (optional, server-side only) ───
# Create a dedicated Sentinel project and use its one-time-display project key.
# Never expose this key in the VS Code webview/browser bundle.
ECHOFORGE_SENTINEL_URL=https://app.echoforge.com
ECHOFORGE_SENTINEL_PROJECT_KEY=
ECHOFORGE_SENTINEL_TIMEOUT_MS=5000

# ─── Optional: Stripe ───
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO_MONTH=price_...
# STRIPE_PRICE_TEAM_MONTH=price_...

# ─── Optional: Flutterwave ───
# FLUTTERWAVE_SECRET_KEY=FLWSECK-...
# FLUTTERWAVE_SECRET_HASH=your_flutterwave_webhook_secret_hash

# ─── Optional: Analytics ───
# MIXPANEL_TOKEN=your_token
# POSTHOG_API_KEY=your_key

# ─── Optional: Customer Support ───
# INTERCOM_APP_ID=your_app_id
# SENDGRID_API_KEY=SG.your_key
