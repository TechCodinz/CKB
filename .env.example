# CKB Environment Variables
# Copy this file to .env and fill in your values

# ─── Database (Supabase) ───
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# ─── Auth (REQUIRED — backend refuses to start in production without this) ───
# Generate with: openssl rand -base64 48
JWT_SECRET=

# ─── Payments (Coinbase Commerce) ───
COINBASE_COMMERCE_API_KEY=your_coinbase_api_key
COINBASE_COMMERCE_WEBHOOK_SECRET=your_webhook_shared_secret

# ─── Internal service-to-service auth ───
# Shared secret used by web/api/webhooks/coinbase.js (a separate Vercel
# deployment) to call the backend's /api/v1/internal/grant-access route.
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=
# URL of the deployed backend (server.ts), used by the same webhook.
BACKEND_URL=https://your-ckb-api.onrender.com

# ─── Frontend (React Dashboard) ───
REACT_APP_API_URL=https://your-ckb-api.onrender.com

# ─── MCP Server ───
# If unset, the REST API in mcp-server runs WITHOUT auth — fine for pure
# localhost use, but required before exposing it beyond 127.0.0.1.
# Simple/single-tenant mode: one shared key, no per-user usage tracking.
CKB_API_KEY=
# Per-user mode (usage-based billing): validates keys against the backend's
# real ApiKeyService instead of a single shared key, and records usage per
# call for billing. Takes priority over CKB_API_KEY when both are set.
# CKB_INTERNAL_SECRET must be the SAME VALUE as the backend's
# INTERNAL_API_SECRET below (different env var name, same shared secret).
CKB_BACKEND_URL=
CKB_INTERNAL_SECRET=
# Set to your dashboard's origin to allow browser calls; "*" is dev-only.
CKB_ALLOWED_ORIGIN=
# Set to "1" to bind 0.0.0.0 instead of the safer 127.0.0.1 default.
CKB_BIND_ALL=
# Optional: enables the ckb_explain_violation MCP tool / /api/v1/violations/explain
# route, which asks Claude to explain a violation and suggest a fix.
ANTHROPIC_API_KEY=
# Optional: overrides the model used for explain-fix (defaults to a fast/cheap one).
# CKB_EXPLAIN_MODEL=claude-haiku-4-5-20251001

# ─── Optional: Stripe (for credit card payments) ───
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO_MONTH=price_...
# STRIPE_PRICE_TEAM_MONTH=price_...

# ─── Optional: Flutterwave ───
# FLUTTERWAVE_SECRET_KEY=FLWSECK-...
# FLUTTERWAVE_SECRET_HASH=your_flutterwave_webhook_secret_hash

# ─── Optional: Analytics ───
# MIXPANEL_TOKEN=your_token
# POSTHOG_API_KEY=your_key

# ─── Optional: Customer Support ───
# INTERCOM_APP_ID=your_app_id
# SENDGRID_API_KEY=SG.your_key
