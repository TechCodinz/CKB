# Copy to /opt/platform/ckb/core/deploy/shared-vps/.env on the VPS.
# NEVER commit the real .env.

CKB_MESH_NETWORK=ckb_mesh
CKB_MCP_HOST_PORT=8320

# Internal Docker URL for the paired CKB Cloud API.
CKB_BACKEND_URL=http://ckb-api:3000

# Must exactly match INTERNAL_API_SECRET in ckb-cloud's private .env.
CKB_INTERNAL_SECRET=replace-with-the-same-ckb-internal-secret

# Browser CORS is intentionally limited to the public CKB frontend.
CKB_ALLOWED_ORIGIN=https://ckb-nu.vercel.app

# CKB MCP resource envelope. Paired with the 768m API default, this keeps the
# combined CKB application budget near 1.5 GB and protects co-hosted services.
CKB_MCP_MEMORY_LIMIT=768m
CKB_MCP_CPUS=1.0
