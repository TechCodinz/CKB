FROM rust:1.88-bookworm AS builder

WORKDIR /src
COPY . .
RUN cargo build --locked --release -p ckb-mcp-server --bin ckb-mcp-server

FROM debian:bookworm-slim AS runner

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl libssl3 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --create-home --home-dir /home/ckb ckb \
    && mkdir -p /data \
    && chown -R ckb:ckb /data

COPY --from=builder /src/target/release/ckb-mcp-server /usr/local/bin/ckb-mcp-server

USER ckb
WORKDIR /data

ENV PORT=3000
ENV CKB_BIND_ALL=1

EXPOSE 3000
ENTRYPOINT ["/usr/local/bin/ckb-mcp-server"]
